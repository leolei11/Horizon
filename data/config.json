{
  "ai": {
    "provider": "openai",
    "provider_chain": "openai",
    "model": "deepseek-ai/DeepSeek-V3",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key_env": "SILICONFLOW_API_KEY",
    "fallback_model": "deepseek-ai/DeepSeek-V3",
    "fallback_base_url": "https://api.siliconflow.cn/v1",
    "fallback_api_key_env": "SILICONFLOW_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.2,
    "analysis_concurrency": 2,
    "analysis_batch_size": 5,
    "enrichment_concurrency": 2,
    "enrichment_batch_size": 5,
    "enrichment_search_mode": "targeted",
    "enrichment_search_results": 2,
    "enrichment_search_timeout_sec": 10,
    "enrichment_min_content_chars": 800,
    "enrichment_content_max_chars": 2000,
    "enrichment_comments_max_chars": 800,
    "enrichment_output_detail": "full",
    "enrichment_retry_attempts": 1,
    "enrichment_failure_fallback": "summary",
    "enrichment_cache_ttl_days": 30,
    "enrichment_cache_path": "data/enrichment-cache.json",
    "enrichment_cache_scope": "all",
    "languages": [
      "zh"
    ],
    "interest_profile": "聚焦综合技术与 SaaS 创作领域（每日总数 20 条）：前 10 条精选 GitHub 热门开源、SaaS 架构、现代 CSS 特效、后端实战；后 10 条为【AI 落地应用与提效工具】专属配额，100% 聚焦具备直接使用与落地价值的 AI 产物（开源 AI 桌面/Web 应用、Agent 工作流框架、Codex/Antigravity 提效技巧与插件、API 极简集成库）。一票否决纯学术论文与模型对比，摘要第一句用平实大白话说明‘这是一个干什么用的 AI 应用/工具’。遴选兼具技术深度与落地实用价值的资讯，严格去重，不推送重复内容。",
    "reader_profile": "面向实操落地导向的全栈开发者、独立开发者与 AI 工具使用者。摒弃抽象高深的学术理论与算法推导，摘要第一句必须用最平实无门槛的大白话说明‘这是一个干什么用的工具/框架/软件’。重点呈现：1. 实际应用场景与能解决的具体痛点；2. 核心功能亮点与落地提效价值（如省时、省显存、免配置开箱即用）；3. 上手门槛、具体使用步骤与适用人群。严禁无意义的学术名词堆砌与套话。",
    "deprioritized_topics": []
  },
  "sources": {
