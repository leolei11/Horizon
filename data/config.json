  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 1.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 1.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 1.0,
        "topic_dedup": true
      }
    }
  },
  "collection": {
    "time_window_hours": 72
  },
  "digest": {
    "max_items": 20,
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": true,
    "url_env": "BARK_URL",
    "delivery": "summary",
    "platform": "bark",
    "layout": "markdown",
    "request_body": {
      "title": "#{message_title}",
      "body": "#{summary?limit=800&split=\\n}",
      "group": "Horizon",
      "url": "https://leolei11.github.io/Horizon/",
      "isArchive": "1"
    }
  }
