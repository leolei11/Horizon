{
  "ai": {
    "provider": "antigravity",
    "model": "gemini-2.5-flash",
    "api_key_env": "GEMINI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 4.0,
    "analysis_concurrency": 1,
    "analysis_batch_size": 5,
    "enrichment_concurrency": 2,
    "enrichment_batch_size": 5,
    "enrichment_search_mode": "targeted",
    "enrichment_search_results": 2,
    "enrichment_search_timeout_sec": 10,
    "enrichment_min_content_chars": 800,
    "enrichment_content_max_chars": 2000,
    "enrichment_comments_max_chars": 800,
    "enrichment_output_detail": "full",
    "enrichment_retry_attempts": 1,
    "enrichment_failure_fallback": "summary",
    "enrichment_cache_ttl_days": 30,
    "enrichment_cache_path": "data/enrichment-cache.json",
    "enrichment_cache_scope": "all",
    "languages": [
      "zh"
    ],
    "interest_profile": "聚焦 6 大综合技术领域：1. AI 前沿与 Agent 工作流（LLM 应用开发、RAG 落地、Agent 设计模式、Cursor/Copilot 高级技巧、AI 提效工具）；2. 现代前端与 CSS 特效（现代 CSS 布局/动画、React/Next.js/Vue 实战、跨端/桌面应用开发）；3. 后端开发与系统架构（Python/Node.js/Go/Java 后端技巧、API 设计、高并发/微服务架构模式）；4. 数据库与存储（PostgreSQL 进阶/索引优化、Redis 缓存策略、向量数据库应用、数据持久化）；5. 简历优化、求职投递与面试实战（开源项目亮点包装、简历高光点打造、技术面试硬核 Q&A、职场成长）；6. GitHub 热门开源与经典名库（每天总榜按顺序顺延 1 个经典名库，每天 2 个 GitHub Trending 热门新神器）。遴选兼具技术深度与落地实用价值的资讯，严格去重，不推送重复内容。",
    "reader_profile": "面向具备一定技术基础的全栈/应用开发者与 AI 使用者。精炼拆解核心技术原理、代码/架构亮点、实际落地应用场景、使用门槛与技术选型建议。单篇摘要字数保持在 300 字左右，专业干练，直击干货，拒绝过分幼稚的比喻或无意义的学术堆砌。",
    "deprioritized_topics": []
  },
  "sources": {
    "github": [
      {
        "type": "trending_curriculum",
        "trending_periods": [
          "daily",
          "weekly"
        ],
        "trending_limit": 15,
        "curriculum_items_per_day": 1,
        "curriculum_batches": [
          [
            "freeCodeCamp/freeCodeCamp"
          ],
          [
            "EbookFoundation/free-programming-books"
          ],
          [
            "sindresorhus/awesome"
          ],
          [
            "jwasham/coding-interview-university"
          ],
          [
            "donnemartin/system-design-primer"
          ],
          [
            "kamranahmedse/developer-roadmap"
          ],
          [
            "vinta/awesome-python"
          ],
          [
            "public-apis/public-apis"
          ],
          [
            "codecrafters-io/build-your-own-x"
          ],
          [
            "getify/You-Dont-Know-JS"
          ],
          [
            "trekhleb/javascript-algorithms"
          ],
          [
            "labuladong/fucking-algorithm"
          ],
          [
            "facebook/react"
          ],
          [
            "vuejs/core"
          ],
          [
            "vercel/next.js"
          ],
          [
            "microsoft/vscode"
          ]
        ],
        "enabled": true,
        "category": "github-trending-and-classics"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 25,
      "min_score": 50
    },
    "rss": [
      {
        "name": "Josh W. Comeau (CSS & Frontend)",
        "url": "https://www.joshwcomeau.com/rss.xml",
        "enabled": true,
        "category": "frontend-css"
      },
      {
        "name": "Codrops (CSS Animations & Design)",
        "url": "https://tympanus.net/codrops/feed/",
        "enabled": true,
        "category": "frontend-css"
      },
      {
        "name": "CSS-Tricks (Frontend & CSS)",
        "url": "https://css-tricks.com/feed/",
        "enabled": true,
        "category": "frontend-css"
      },
      {
        "name": "Web.dev (Modern Web Standards)",
        "url": "https://web.dev/feed.xml",
        "enabled": true,
        "category": "web-dev"
      },
      {
        "name": "ByteByteGo (System Design & Architecture)",
        "url": "https://blog.bytebytego.com/feed",
        "enabled": true,
        "category": "backend-architecture"
      },
      {
        "name": "Real Python (Python & Backend)",
        "url": "https://realpython.com/atom.xml",
        "enabled": true,
        "category": "backend-python"
      },
      {
        "name": "PostgreSQL Weekly (Databases & Storage)",
        "url": "https://postgresweekly.com/rss/",
        "enabled": true,
        "category": "database-storage"
      },
      {
        "name": "freeCodeCamp News (Tutorials & Career)",
        "url": "https://www.freecodecamp.org/news/rss/",
        "enabled": true,
        "category": "tutorials-career"
      },
      {
        "name": "Simon Willison (AI & Tools)",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Hugging Face Blog (Open-Source AI)",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Dev.to Career (Resume & Interview)",
        "url": "https://dev.to/feed/tag/career",
        "enabled": true,
        "category": "career-resume"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "JavaScript",
        "TypeScript",
        "Python",
        "Go",
        "CSS",
        "HTML"
      ],
      "keywords": [
        "agent",
        "ai",
        "llm",
        "css",
        "frontend",
        "backend",
        "database",
        "postgres",
        "system-design",
        "resume",
        "interview",
        "tutorial"
      ],
      "min_stars": 10,
      "max_items": 20
    }
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 1.0,
        "topic_dedup": true
      }
    }
  },
  "collection": {
    "time_window_hours": 72
  },
  "digest": {
    "max_items": 10,
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": true,
    "url_env": "BARK_URL",
    "delivery": "summary",
    "platform": "bark",
    "layout": "markdown",
    "request_body": {
      "title": "Horizon 日报 (#{date})",
      "body": "#{summary}",
      "group": "Horizon",
      "isArchive": "1"
    }
  }
}
