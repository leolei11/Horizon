{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GEMINI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 7.0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "request_timeout_sec": 45,
    "max_retries": 1,
    "languages": [
      "zh"
    ]
  },
  "interests": {
    "enabled": true,
    "audience": "Neo：实操导向的全栈与独立开发者，同时关注 AI 产品编辑、AI 求职和 AI 视频剪辑。日报应帮助他当天决定值得试用、学习、写作或做成视频的内容。",
    "include_topics": [
      "可直接安装或试用的 AI 应用",
      "Agent 工作流与 API 集成",
      "Codex 与 Antigravity 提效技巧",
      "AI 视频剪辑与内容生产",
      "AI 产品编辑与求职机会",
      "GitHub 开源项目",
      "SaaS 架构与独立开发",
      "现代前端、后端与数据库实战"
    ],
    "exclude_topics": [
      "Claude Code"
    ],
    "hard_reject_rules": [
      "纯学术论文、模型跑分或参数对比，且没有近期可使用的产品、代码或明确开发者行动",
      "泛科技社会新闻，与 AI 应用、软件开发、内容生产或求职没有直接关系",
      "纯宣传、重复报道、缺少可验证来源或无法说明读者能拿它做什么",
      "标题或正文的核心主题是 Claude Code"
    ],
    "min_relevance_score": 7.0,
    "min_actionability_score": 6.0,
    "buckets": {
      "applied-ai": {
        "name": "AI 落地与提效",
        "target_count": 10,
        "description": "能直接试用、集成或转化为内容的 AI 产品、Agent、工作流、视频工具、求职与编辑机会。",
        "priority_topics": [
          "AI 应用",
          "Agent",
          "Codex",
          "Antigravity",
          "AI 剪辑",
          "AI 求职",
          "API 集成"
        ]
      },
      "builder-stack": {
        "name": "开发与 SaaS 实战",
        "target_count": 10,
        "description": "对全栈、独立开发和 SaaS 产品构建有直接复用价值的开源项目与工程实践。",
        "priority_topics": [
          "GitHub 开源",
          "SaaS 架构",
          "现代 CSS",
          "后端",
          "数据库",
          "系统设计"
        ]
      }
    }
  },
