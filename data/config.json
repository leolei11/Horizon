    "profile": "tech-news"
    }
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 8.0,
        "topic_dedup": true
      }
    }
  },
  "collection": {
    "time_window_hours": 48
  },
  "digest": {
    "max_items": 20,
    "require_exact_count": true,
    "require_unique_items": true,
    "quota_optimized_ai": true,
    "ai_request_budget": 20,
    "analysis_batch_count": 12,
    "enrichment_batch_count": 2,
    "transient_retry_delay_sec": 30,
    "category_groups": {
      "applied-ai": {
        "name": "AI 落地与提效",
        "limit": 10,
        "categories": [
          "applied-ai"
        ]
      },
      "builder-stack": {
        "name": "开发与 SaaS 实战",
        "limit": 10,
        "categories": [
          "builder-stack"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "video": {
    "enabled": true,
    "auto_render": true,
    "languages": [
      "zh"
    ],
    "max_items": 5,
    "min_video_score": 7.0,
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "voice": "zh-CN-YunxiNeural",
    "renderer_dir": "video",
    "output_dir": "data/videos"
  },
  "webhook": {
    "enabled": true,
    "url_env": "BARK_URL",
    "delivery": "summary",
    "platform": "bark",
    "layout": "markdown",
    "request_body": {
      "title": "#{message_title}",
      "body": "#{summary?limit=800&split=\\n}",
      "group": "Horizon",
      "url": "https://leolei11.github.io/Horizon/",
      "isArchive": "1"
    }
  }
}
